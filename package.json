{
  "name": "saikinobot11",
  "version": "2.0.0",
  "description": "身内用 Discord Bot（Cloudflare Workers + D1）: サーバー内通貨・アクション報酬・ミニゲーム・ユーザーショップ",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node test/run-tests.mjs && node test/menu-tests.mjs && node test/poker-tests.mjs && node test/dice-tests.mjs && node test/safety-tests.mjs",
    "check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "register": "node scripts/register-commands.mjs",
    "migrate": "wrangler d1 migrations apply saikinobot --remote",
    "usage": "node scripts/usage.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "better-sqlite3": "^13.0.3",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "wrangler": "4.157.0"
  }
}
