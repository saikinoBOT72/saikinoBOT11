# VPS や自宅サーバーで常時稼働させるための systemd ユニット。
#   sudo cp deploy/saikinobot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now saikinobot
#   journalctl -u saikinobot -f     # ログを見る
#
# WorkingDirectory と User は自分の環境に合わせて書き換えてください。
# トークンなどは同じフォルダの .env から読み込まれます。

[Unit]
Description=saikinoBOT11 Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/saikinoBOT11
ExecStart=/usr/bin/node src/index.js
User=saikinobot
Restart=always
RestartSec=5
# ログを journald に流す
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
