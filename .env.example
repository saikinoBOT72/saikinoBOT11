# Discord Developer Portal (https://discord.com/developers/applications) から取得
DISCORD_TOKEN=あなたのBotトークン
CLIENT_ID=BotのApplication ID

# 開発用: 指定するとこのサーバーだけに即時でコマンドが登録される（未指定ならグローバル登録＝反映に最大1時間）
GUILD_ID=

# 任意設定
# true にすると特権インテント Message Content を使い、メンション無しでも画像を受け取れる
# （Developer Portal の Bot ページで Message Content Intent を ON にしてから true にすること）
MESSAGE_CONTENT_INTENT=false

DATABASE_PATH=./data/economy.db
IMAGE_DIR=./data/images
TZ=Asia/Tokyo
